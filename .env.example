# Safe defaults for the credential-free local Mock/offline demo.
SPRING_AI_DASHSCOPE_ENABLED=false
SMARTPARK_ANALYTICS_ENABLED=false
SMARTPARK_ANALYTICS_DEMO_DATA_REFRESH_ENABLED=false
SMARTPARK_ANALYTICS_DB_NAME=smartpark_analytics

# Optional LAN access. Keep the secure loopback defaults unless remote access
# is explicitly needed for a local demo.
SMARTPARK_FRONTEND_BIND_HOST=127.0.0.1
SMARTPARK_VOICE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required only with compose.analytics.yaml and the analytics profile.
AI_DASHSCOPE_API_KEY=
SMARTPARK_ANALYTICS_DB_ADMIN_PASSWORD=
SMARTPARK_ANALYTICS_DB_RO_PASSWORD=
